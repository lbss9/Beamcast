<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <RootNamespace>Beamcast.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The host is built with the tests and started by them as a separate process on 127.0.0.1
       (HostFixture); its assembly is not referenced, so the shared protocol sources do not clash. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Beamcast.Server\Beamcast.Server.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Beamcast\Logic\AppInfo.cs" Link="Logic\AppInfo.cs" />
    <Compile Include="..\..\src\Beamcast\Logic\AppLanguage.cs" Link="Logic\AppLanguage.cs" />
    <Compile Include="..\..\src\Beamcast\Logic\QualityPreset.cs" Link="Logic\QualityPreset.cs" />
    <Compile Include="..\..\src\Beamcast\Logic\SafeTry.cs" Link="Logic\SafeTry.cs" />
    <Compile Include="..\..\src\Beamcast\Logic\AdaptiveBitrate.cs" Link="Logic\AdaptiveBitrate.cs" />
    <Compile Include="..\..\src\Beamcast\Logic\ViewerLagPolicy.cs" Link="Logic\ViewerLagPolicy.cs" />
    <Compile Include="..\..\src\Beamcast\Logic\BroadcastProfile.cs" Link="Logic\BroadcastProfile.cs" />
    <Compile Include="..\..\src\Beamcast\Codec\VideoCodec.cs" Link="Codec\VideoCodec.cs" />
    <Compile Include="..\..\src\Beamcast\Net\Protocol.cs" Link="Net\Protocol.cs" />
    <Compile Include="..\..\src\Beamcast\Net\Messages.cs" Link="Net\Messages.cs" />
    <Compile Include="..\..\src\Beamcast\Net\FrameGate.cs" Link="Net\FrameGate.cs" />
    <Compile Include="..\..\src\Beamcast\Net\SecureChannel.cs" Link="Net\SecureChannel.cs" />
    <Compile Include="..\..\src\Beamcast\Net\LoungeProtocol.cs" Link="Net\LoungeProtocol.cs" />
    <Compile Include="..\..\src\Beamcast\Net\LoungeCrypto.cs" Link="Net\LoungeCrypto.cs" />
    <Compile Include="..\..\src\Beamcast\Net\LoungeInvite.cs" Link="Net\LoungeInvite.cs" />
    <Compile Include="..\..\src\Beamcast\Net\JoinRateLimiter.cs" Link="Net\JoinRateLimiter.cs" />
    <Compile Include="..\..\src\Beamcast\Net\PeerLink.cs" Link="Net\PeerLink.cs" />
    <Compile Include="..\..\src\Beamcast\Net\LoungeClient.cs" Link="Net\LoungeClient.cs" />
    <Compile Include="..\..\src\Beamcast\Logic\ViewerCongestion.cs" Link="Logic\ViewerCongestion.cs" />
    <Compile Include="..\..\src\Beamcast\Logic\ViewerQuality.cs" Link="Logic\ViewerQuality.cs" />
    <Compile Include="..\..\src\Beamcast\Logic\Diag.cs" Link="Logic\Diag.cs" />
    <Compile Include="..\..\src\Beamcast\Audio\AudioMixer.cs" Link="Audio\AudioMixer.cs" />
    <Compile Include="..\..\src\Beamcast\Audio\AudioSourceSelector.cs" Link="Audio\AudioSourceSelector.cs" />
    <Compile Include="..\..\src\Beamcast\Audio\ProcessTable.cs" Link="Audio\ProcessTable.cs" />
    <Compile Include="..\..\src\Beamcast\Codec\Frames.cs" Link="Codec\Frames.cs" />
    <Compile Include="..\..\src\Beamcast\Codec\FrameScaler.cs" Link="Codec\FrameScaler.cs" />
  </ItemGroup>
</Project>
