<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Beamcast.UpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Beamcast"
>
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid
                Grid.Column="0"
                Width="18"
                Height="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
            >
                <Ellipse Width="18" Height="18" Fill="{StaticResource BeamAccentSoftBrush}" />
                <Ellipse
                    Width="8"
                    Height="8"
                    Fill="{StaticResource BeamAccentBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                />
            </Grid>
            <TextBlock
                Grid.Column="1"
                x:Uid="Update_WindowTitle"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
            />
        </Grid>

        <!-- Hero: what is on offer -->
        <Border
            Grid.Row="1"
            Margin="20,4,20,0"
            CornerRadius="14"
            Padding="18,16"
            Background="{StaticResource BeamAccentSoftBrush}"
        >
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="44"
                    Height="44"
                    CornerRadius="12"
                    Background="{StaticResource BeamAccentBrush}"
                    VerticalAlignment="Top"
                >
                    <FontIcon Glyph="&#xE896;" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock
                        x:Uid="Update_Badge"
                        FontSize="11"
                        FontWeight="SemiBold"
                        CharacterSpacing="60"
                        Foreground="{StaticResource BeamAccentBrush}"
                    />
                    <TextBlock x:Name="VersionText" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="CurrentText" Opacity="0.7" Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock
                        x:Uid="Update_Lead"
                        Margin="0,6,0,0"
                        TextWrapping="Wrap"
                        Opacity="0.85"
                        Style="{ThemeResource BodyTextBlockStyle}"
                    />
                </StackPanel>
            </Grid>
        </Border>

        <!-- What changes -->
        <ScrollViewer
            Grid.Row="2"
            Margin="20,12,20,0"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
        >
            <Border
                CornerRadius="12"
                Padding="16,12,16,14"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            >
                <StackPanel Spacing="6">
                    <TextBlock x:Uid="Update_ChangelogHeading" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <RichTextBlock x:Name="ChangelogView" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer: reassurance, progress, actions -->
        <StackPanel Grid.Row="3" Padding="20,10,20,16" Spacing="10">
            <TextBlock
                x:Uid="Update_Assurance"
                TextWrapping="Wrap"
                Opacity="0.7"
                Style="{ThemeResource CaptionTextBlockStyle}"
            />
            <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" />
            <!-- Status gets the whole width (a horizontal StackPanel would never let it wrap). -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ProgressRing x:Name="Spinner" Width="16" Height="16" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="1"
                    Opacity="0.8"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="LaterButton" x:Uid="Update_Later" MinWidth="100" Click="OnLater" />
                <Button
                    x:Name="InstallButton"
                    x:Uid="Update_Install"
                    MinWidth="160"
                    Click="OnInstall"
                    Style="{ThemeResource AccentButtonStyle}"
                />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
