<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Beamcast.Controls.SettingsRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Border
        x:Name="Root"
        CornerRadius="8"
        Padding="14,12"
        MinHeight="60"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
    >
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="Icon" Grid.Column="0" FontSize="18" VerticalAlignment="Center" Opacity="0.9" />
            <CheckBox x:Name="Check" Grid.Column="0" MinWidth="0" Margin="0,0,-10,0" VerticalAlignment="Center" Visibility="Collapsed" Checked="OnCheckChanged" Unchecked="OnCheckChanged" />
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderText" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="DescriptionText" Opacity="0.65" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <ContentPresenter x:Name="Action" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
    </Border>
</UserControl>
