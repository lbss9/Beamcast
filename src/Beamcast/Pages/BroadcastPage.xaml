<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Beamcast.Pages.BroadcastPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cap="using:Beamcast.Capture"
    xmlns:net="using:Beamcast.Net"
    xmlns:ctrl="using:Beamcast.Controls"
>
    <Page.Resources>
        <DataTemplate x:Key="SourceTemplate" x:DataType="cap:CaptureSource">
            <Grid ColumnSpacing="10" Padding="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="34"
                    Height="34"
                    CornerRadius="8"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    VerticalAlignment="Center"
                >
                    <FontIcon
                        Glyph="{x:Bind Kind, Converter={StaticResource KindGlyph}}"
                        FontSize="15"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                    />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        Style="{ThemeResource BodyTextBlockStyle}"
                    />
                    <TextBlock
                        Opacity="0.62"
                        TextTrimming="CharacterEllipsis"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                    >
                        <Run Text="{x:Bind Subtitle}" />
                        <Run Text="  " />
                        <Run Text="{x:Bind SizeLabel}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ViewerTemplate" x:DataType="net:ViewerInfo">
            <Grid ColumnSpacing="10" Padding="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE77B;" FontSize="14" VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Name}"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                />
                <TextBlock
                    Grid.Column="2"
                    Text="{x:Bind RemoteAddress}"
                    Opacity="0.55"
                    VerticalAlignment="Center"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="12,4,20,16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <TextBlock x:Uid="Sources_Heading" Style="{StaticResource SectionHeaderStyle}" />
                <Button
                    x:Name="RefreshButton"
                    x:Uid="Sources_Refresh"
                    Style="{StaticResource GhostButtonStyle}"
                    HorizontalAlignment="Right"
                    Click="OnRefreshSources"
                >
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="Sources_Monitors" Style="{StaticResource HintTextStyle}" />
                    <ListView
                        x:Name="MonitorsList"
                        SelectionMode="Single"
                        ItemTemplate="{StaticResource SourceTemplate}"
                        SelectionChanged="OnMonitorSelected"
                    />
                    <TextBlock
                        x:Uid="Sources_Windows"
                        Margin="0,10,0,0"
                        Style="{StaticResource HintTextStyle}"
                    />
                    <ListView
                        x:Name="WindowsList"
                        SelectionMode="Single"
                        ItemTemplate="{StaticResource SourceTemplate}"
                        SelectionChanged="OnWindowSelected"
                    />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <Border
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="#0A0D12"
                >
                    <Grid Height="320">
                        <ctrl:GpuVideoView x:Name="Preview" />
                        <StackPanel
                            x:Name="PreviewHint"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                        >
                            <FontIcon
                                Glyph="&#xE7F4;"
                                FontSize="34"
                                Opacity="0.5"
                                Foreground="White"
                                HorizontalAlignment="Center"
                            />
                            <TextBlock
                                x:Uid="Preview_Hint"
                                Foreground="White"
                                Opacity="0.7"
                                HorizontalAlignment="Center"
                            />
                        </StackPanel>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="12"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                        >
                            <Border
                                x:Name="LiveBadge"
                                Visibility="Collapsed"
                                CornerRadius="6"
                                Padding="8,2"
                                Background="{StaticResource BeamLiveBrush}"
                            >
                                <TextBlock
                                    Text="LIVE"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="White"
                                />
                            </Border>
                            <Border
                                x:Name="PausedBadge"
                                Visibility="Collapsed"
                                CornerRadius="6"
                                Padding="8,2"
                                Background="#CC333B48"
                            >
                                <TextBlock
                                    x:Uid="Preview_Paused"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="White"
                                />
                            </Border>
                        </StackPanel>
                        <Border
                            x:Name="StatsBadge"
                            Visibility="Collapsed"
                            CornerRadius="6"
                            Padding="8,3"
                            Margin="12"
                            Background="#B3000000"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                        >
                            <TextBlock
                                x:Name="StatsText"
                                Foreground="White"
                                FontFamily="Cascadia Mono, Consolas, Courier New"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                            />
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button
                        x:Name="GoLiveButton"
                        x:Uid="Action_GoLive"
                        Style="{StaticResource AccentButtonStyle}"
                        MinWidth="160"
                        Click="OnGoLive"
                    />
                    <Button
                        x:Name="PauseButton"
                        x:Uid="Action_Pause"
                        Visibility="Collapsed"
                        Click="OnPause"
                    />
                    <Button
                        x:Name="StopButton"
                        x:Uid="Action_Stop"
                        Visibility="Collapsed"
                        Click="OnStop"
                    />
                    <TextBlock
                        x:Name="ErrorText"
                        Foreground="{StaticResource BeamAccentBrush}"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                    />
                </StackPanel>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="Quality_Heading" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <ComboBox
                                x:Name="EncoderBox"
                                x:Uid="Quality_Encoder"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnEncoderChanged"
                            />
                            <ComboBox
                                x:Name="PresetBox"
                                x:Uid="Quality_Preset"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnQualityChanged"
                            />
                            <ComboBox
                                x:Name="FpsBox"
                                x:Uid="Quality_Fps"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnQualityChanged"
                            />
                            <NumberBox
                                x:Name="BitrateBox"
                                x:Uid="Quality_Bitrate"
                                Minimum="300"
                                Maximum="50000"
                                SmallChange="250"
                                LargeChange="1000"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnBitrateChanged"
                            />
                            <ToggleSwitch
                                x:Name="CursorSwitch"
                                x:Uid="Quality_Cursor"
                                Toggled="OnCursorToggled"
                            />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="Session_Heading" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBox x:Name="SessionNameBox" x:Uid="Session_Name" MaxLength="48" />
                            <ComboBox
                                x:Name="ModeBox"
                                x:Uid="Session_Mode"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnModeChanged"
                            />
                            <NumberBox
                                x:Name="PortBox"
                                x:Uid="Session_Port"
                                Minimum="1"
                                Maximum="65535"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnInviteInputChanged"
                            />
                            <PasswordBox
                                x:Name="PasswordBox"
                                x:Uid="Session_Password"
                                PasswordRevealMode="Peek"
                                MaxLength="64"
                                PasswordChanged="OnPasswordChanged"
                            />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="Invite_Heading" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="InviteStatusText" Style="{StaticResource HintTextStyle}" />
                        <Grid x:Name="AddressRow" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="AddressBox"
                                x:Uid="Invite_Address"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnInviteInputChanged"
                            />
                            <Button
                                x:Name="PublicIpButton"
                                x:Uid="Invite_PublicIp"
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Click="OnFindPublicIp"
                            />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="InviteCodeBox"
                                x:Uid="Invite_Code"
                                IsReadOnly="True"
                                FontFamily="Cascadia Mono, Consolas, Courier New"
                            />
                            <Button
                                x:Name="CopyButton"
                                x:Uid="Invite_Copy"
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Click="OnCopyInvite"
                            />
                        </Grid>
                        <TextBlock x:Name="InviteHintText" Style="{StaticResource HintTextStyle}" />
                        <TextBlock
                            x:Uid="Invite_StudyNote"
                            Style="{StaticResource HintTextStyle}"
                            Foreground="{StaticResource BeamAccentBrush}"
                            Opacity="0.9"
                        />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock x:Uid="Viewers_Heading" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Name="ViewersCountText"
                                HorizontalAlignment="Right"
                                Opacity="0.7"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                            />
                        </Grid>
                        <TextBlock x:Name="ViewersEmptyText" x:Uid="Viewers_Empty" Style="{StaticResource HintTextStyle}" />
                        <ListView
                            x:Name="ViewersList"
                            SelectionMode="None"
                            ItemTemplate="{StaticResource ViewerTemplate}"
                        />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
