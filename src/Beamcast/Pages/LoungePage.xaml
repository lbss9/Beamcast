<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Beamcast.Pages.LoungePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Grid Padding="12,4,20,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="14" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                <TextBlock x:Uid="Lounge_Heading" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock x:Uid="Lounge_Summary" Style="{StaticResource HintTextStyle}" />
            </StackPanel>
            <TextBox x:Name="NameBox" x:Uid="Lounge_YourName" Grid.Column="1" MaxLength="32" VerticalAlignment="Bottom" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="12,10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Uid="Lounge_HostsHeading" Grid.Row="0" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="HostsEmptyText" x:Uid="Lounge_HostsEmpty" Style="{StaticResource HintTextStyle}" />
                            <ItemsControl x:Name="HostsList" />
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Spacing="6">
                        <TextBox x:Name="AddHostBox" x:Uid="Lounge_AddHost" TextChanged="OnAddHostChanged" KeyDown="OnAddHostKeyDown" />
                        <Button x:Name="AddHostButton" x:Uid="Lounge_AddHostButton" HorizontalAlignment="Stretch" IsEnabled="False" Click="OnAddHost" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <StackPanel x:Name="NoHostPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE968;" FontSize="34" Opacity="0.5" HorizontalAlignment="Center" />
                    <TextBlock x:Uid="Lounge_SelectHost" Style="{StaticResource HintTextStyle}" HorizontalAlignment="Center" />
                </StackPanel>

                <ScrollViewer x:Name="HostPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="0" VerticalAlignment="Center">
                                <TextBlock x:Name="HostTitleText" Style="{ThemeResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="HostStatusText" Style="{StaticResource HintTextStyle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ProgressRing x:Name="HostProgress" Grid.Column="1" IsActive="False" Width="20" Height="20" />
                            <Button x:Uid="Lounge_Refresh" Grid.Column="2" Style="{StaticResource GhostButtonStyle}" Click="OnRefreshHost">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                            <Button x:Name="CreateButton" x:Uid="Lounge_CreateButton" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Click="OnCreate" />
                        </Grid>

                        <StackPanel Spacing="8">
                            <TextBlock
                                x:Name="ErrorText"
                                Foreground="{StaticResource BeamAccentBrush}"
                                TextWrapping="Wrap"
                            />
                            <Button
                                x:Name="HostKeyButton"
                                Visibility="Collapsed"
                                HorizontalAlignment="Left"
                                Click="OnHostKey"
                            >
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE192;" FontSize="14" />
                                    <TextBlock x:Uid="Lounge_HostKeyButtonText" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Style="{StaticResource CardStyle}" Padding="12,10">
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="Lounge_PublicRooms" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="PublicEmptyText" x:Uid="Lounge_PublicRoomsEmpty" Style="{StaticResource HintTextStyle}" />
                                <ItemsControl x:Name="PublicRoomsList" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="12,10">
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="Lounge_OwnedRooms" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="OwnedEmptyText" x:Uid="Lounge_OwnedRoomsEmpty" Style="{StaticResource HintTextStyle}" />
                                <ItemsControl x:Name="OwnedRoomsList" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="12,10">
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="Lounge_FavoriteRooms" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="FavoritesEmptyText" x:Uid="Lounge_FavoriteRoomsEmpty" Style="{StaticResource HintTextStyle}" />
                                <ItemsControl x:Name="FavoriteRoomsList" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock x:Uid="Lounge_JoinHeading" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Uid="Lounge_JoinHint" Style="{StaticResource HintTextStyle}" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CodeBox" x:Uid="Lounge_Code" Grid.Column="0" TextChanged="OnJoinInputChanged" />
                                    <PasswordBox
                                        x:Name="JoinPasswordBox"
                                        x:Uid="Lounge_JoinPassword"
                                        Grid.Column="1"
                                        PasswordRevealMode="Peek"
                                        MaxLength="128"
                                    />
                                    <Button
                                        x:Name="JoinButton"
                                        x:Uid="Lounge_JoinButton"
                                        Grid.Column="2"
                                        VerticalAlignment="Bottom"
                                        MinWidth="110"
                                        IsEnabled="False"
                                        Click="OnJoin"
                                    />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Uid="Lounge_SecurityNote" Style="{StaticResource HintTextStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
