<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Beamcast.Pages.LoungePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:Beamcast.Controls"
>
    <Grid Padding="32,22,32,14" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- the host: name, state, and the two things you do here -->
        <Grid x:Name="HeaderPanel" Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="HostTitleText" Style="{StaticResource ScreenTitleStyle}" MaxWidth="420" />
                    <ContentPresenter x:Name="HostChip" VerticalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock x:Name="HostStatusText" FontSize="13" Foreground="{ThemeResource BeamText2Brush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ProgressRing x:Name="HostProgress" IsActive="False" Width="18" Height="18" Foreground="{ThemeResource BeamAccentBrush}" />
                <Button x:Name="RefreshButton" x:Uid="Lounge_Refresh" Style="{StaticResource BeamButtonStyle}" Width="36" Padding="0" Click="OnRefreshHost">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <Button x:Name="JoinCodeButton" Style="{StaticResource BeamButtonStyle}" Click="OnJoinCode">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8AD;" FontSize="14" />
                        <TextBlock x:Uid="Lounge_JoinCodeText" />
                    </StackPanel>
                </Button>
                <Button x:Name="CreateButton" Style="{StaticResource BeamPrimaryButtonStyle}" Click="OnCreate">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                        <TextBlock x:Uid="Lounge_CreateText" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="NoticeBar" Grid.Row="1" IsOpen="False" Margin="0,-4,0,-4">
            <InfoBar.ActionButton>
                <Button x:Name="NoticeAction" Visibility="Collapsed" Click="OnNoticeAction" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid x:Name="ToolsPanel" Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>
            <ctrl:Segmented x:Name="FilterTabs" Grid.Column="0" SelectionChanged="OnFilterChanged" />
            <AutoSuggestBox x:Name="SearchBox" x:Uid="Lounge_Search" Grid.Column="1" QueryIcon="Find" VerticalAlignment="Center" TextChanged="OnSearchChanged" />
        </Grid>

        <Grid Grid.Row="3">
            <ScrollViewer x:Name="RoomsScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <ItemsRepeater x:Name="RoomsRepeater" Margin="0,0,0,8">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="262" MinItemHeight="128" MinColumnSpacing="16" MinRowSpacing="16" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- first load of a host: the shape of what is coming -->
            <ItemsRepeater x:Name="SkeletonRepeater" Visibility="Collapsed" VerticalAlignment="Top">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="262" MinItemHeight="128" MinColumnSpacing="16" MinRowSpacing="16" ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>

            <!-- one message, one way out: no host, host down, host wants a key, nothing here yet -->
            <StackPanel x:Name="StatePanel" Visibility="Collapsed" MaxWidth="460" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
                <Border x:Name="StateRing" Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center">
                    <FontIcon x:Name="StateIcon" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="StateTitle" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource BeamTextBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,22,0,0" />
                <TextBlock x:Name="StateBody" FontSize="14" LineHeight="21" Foreground="{ThemeResource BeamText2Brush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
                <Grid x:Name="StateFieldRow" ColumnSpacing="10" Margin="0,22,0,0" Width="380" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="StateTextBox" Grid.Column="0" Height="36" Visibility="Collapsed" TextChanged="OnStateTextChanged" KeyDown="OnStateFieldKeyDown" />
                    <PasswordBox x:Name="StatePasswordBox" Grid.Column="0" Height="36" Visibility="Collapsed" PasswordRevealMode="Peek" MaxLength="256" PasswordChanged="OnStatePasswordChanged" KeyDown="OnStateFieldKeyDown" />
                    <Button x:Name="StateFieldButton" Grid.Column="1" Style="{StaticResource BeamPrimaryButtonStyle}" MinWidth="100" IsEnabled="False" Click="OnStateFieldAction" />
                </Grid>
                <StackPanel x:Name="StateActions" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,22,0,0" Visibility="Collapsed">
                    <Button x:Name="StatePrimary" Style="{StaticResource BeamPrimaryButtonStyle}" Click="OnStatePrimary" />
                    <Button x:Name="StateSecondary" Style="{StaticResource BeamButtonStyle}" Click="OnStateSecondary" />
                </StackPanel>
                <TextBlock x:Name="StateNote" Style="{StaticResource FaintTextStyle}" TextAlignment="Center" Margin="0,18,0,0" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xEA18;" FontSize="13" Foreground="{ThemeResource BeamText3Brush}" VerticalAlignment="Center" />
            <TextBlock x:Uid="Lounge_SecurityNote" Style="{StaticResource FaintTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
