<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Beamcast.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:Beamcast.Controls"
>
    <Page.Resources>
        <Style x:Key="SettingsExpanderStyle" TargetType="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="20,4,20,16" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="780" HorizontalAlignment="Center" Spacing="8">

            <!-- identity header -->
            <Grid ColumnSpacing="18" Margin="0,10,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="72" Height="72" VerticalAlignment="Top">
                    <Ellipse Fill="{StaticResource BeamAccentSoftBrush}" />
                    <Ellipse Width="28" Height="28" Fill="{StaticResource BeamAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Beamcast" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                        <Border CornerRadius="6" Padding="7,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <TextBlock x:Uid="Title_StudyBadge" FontSize="10" FontWeight="SemiBold" CharacterSpacing="60" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Uid="Settings_About" TextWrapping="Wrap" Opacity="0.85" />
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="-10,0,0,0">
                        <HyperlinkButton x:Name="DocsLink" x:Uid="Settings_LinkDocs" />
                        <HyperlinkButton x:Name="RepoLink" x:Uid="Settings_LinkRepo" />
                        <HyperlinkButton x:Name="IssueLink" x:Uid="Settings_LinkIssue" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- version and updates -->
            <TextBlock x:Uid="Settings_VersionHeader" Style="{StaticResource SectionHeaderStyle}" />
            <Expander Style="{StaticResource SettingsExpanderStyle}">
                <Expander.Header>
                    <Grid ColumnSpacing="14" Padding="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE777;" FontSize="18" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionText" Style="{ThemeResource BodyTextBlockStyle}" />
                            <TextBlock x:Name="LastCheckText" Opacity="0.65" Style="{ThemeResource CaptionTextBlockStyle}" />
                            <HyperlinkButton x:Name="NotesLink" x:Uid="Settings_ReleaseNotes" Padding="0" Margin="0,-2,0,0" Click="OnReleaseNotes" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <ProgressRing x:Name="UpdateSpinner" Width="18" Height="18" IsActive="False" />
                            <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" Opacity="0.75" Style="{ThemeResource CaptionTextBlockStyle}" MaxWidth="220" TextWrapping="Wrap" />
                            <Button x:Name="CheckUpdatesButton" x:Uid="Settings_CheckUpdates" Click="OnCheckUpdates" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel>
                    <ctrl:SettingsRow x:Name="AutoCheckRow" Nested="True">
                        <ctrl:SettingsRow.ActionContent>
                            <ToggleSwitch x:Name="UpdatesSwitch" MinWidth="0" Toggled="OnUpdatesToggled" />
                        </ctrl:SettingsRow.ActionContent>
                    </ctrl:SettingsRow>
                </StackPanel>
            </Expander>

            <!-- identity -->
            <TextBlock x:Uid="Settings_IdentityHeader" Style="{StaticResource SectionHeaderStyle}" Margin="0,14,0,8" />
            <ctrl:SettingsRow x:Name="NameRow" Glyph="&#xE77B;">
                <ctrl:SettingsRow.ActionContent>
                    <TextBox x:Name="NameBox" MinWidth="240" MaxLength="32" TextChanged="OnNameChanged" />
                </ctrl:SettingsRow.ActionContent>
            </ctrl:SettingsRow>

            <!-- appearance -->
            <TextBlock x:Uid="Settings_AppearanceHeader" Style="{StaticResource SectionHeaderStyle}" Margin="0,14,0,8" />
            <ctrl:SettingsRow x:Name="LanguageRow" Glyph="&#xF2B7;">
                <ctrl:SettingsRow.ActionContent>
                    <ComboBox x:Name="LanguageBox" MinWidth="200" SelectionChanged="OnLanguageChanged" />
                </ctrl:SettingsRow.ActionContent>
            </ctrl:SettingsRow>
            <ctrl:SettingsRow x:Name="ThemeRow" Glyph="&#xE790;">
                <ctrl:SettingsRow.ActionContent>
                    <ComboBox x:Name="ThemeBox" MinWidth="200" SelectionChanged="OnThemeChanged" />
                </ctrl:SettingsRow.ActionContent>
            </ctrl:SettingsRow>
            <ctrl:SettingsRow x:Name="StreamSoundRow" Glyph="&#xE767;">
                <ctrl:SettingsRow.ActionContent>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="StreamSoundPlay" Click="OnPlayStreamSound" />
                        <ToggleSwitch x:Name="StreamSoundSwitch" MinWidth="0" Toggled="OnStreamSoundToggled" />
                    </StackPanel>
                </ctrl:SettingsRow.ActionContent>
            </ctrl:SettingsRow>

            <!-- diagnostics -->
            <TextBlock x:Uid="Settings_DiagHeader" Style="{StaticResource SectionHeaderStyle}" Margin="0,14,0,8" />
            <Expander Style="{StaticResource SettingsExpanderStyle}">
                <Expander.Header>
                    <ctrl:SettingsRow x:Name="DiagRow" Glyph="&#xE9D9;" Bare="True">
                        <ctrl:SettingsRow.ActionContent>
                            <ToggleSwitch x:Name="DiagSwitch" MinWidth="0" Toggled="OnDiagToggled" />
                        </ctrl:SettingsRow.ActionContent>
                    </ctrl:SettingsRow>
                </Expander.Header>
                <StackPanel>
                    <ctrl:SettingsRow x:Name="DiagFolderRow" Nested="True">
                        <ctrl:SettingsRow.ActionContent>
                            <Button x:Uid="Settings_OpenDiagFolder" Click="OnOpenDiagFolder" />
                        </ctrl:SettingsRow.ActionContent>
                    </ctrl:SettingsRow>
                </StackPanel>
            </Expander>
            <ctrl:SettingsRow x:Name="ReportRow" Glyph="&#xEBE8;">
                <ctrl:SettingsRow.ActionContent>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Name="ReportStatus" VerticalAlignment="Center" Opacity="0.75" Style="{ThemeResource CaptionTextBlockStyle}" MaxWidth="260" TextWrapping="Wrap" />
                        <Button x:Name="ReportButton" x:Uid="Settings_BugReport" Click="OnBugReport" />
                    </StackPanel>
                </ctrl:SettingsRow.ActionContent>
            </ctrl:SettingsRow>
        </StackPanel>
    </ScrollViewer>
</Page>
