<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Beamcast.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <ScrollViewer Padding="20,4,20,16" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="780" HorizontalAlignment="Center" Spacing="12">
            <Grid ColumnSpacing="14" Margin="0,10,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource BeamAccentSoftBrush}" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE789;" FontSize="20" Foreground="{StaticResource BeamAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Uid="News_Title" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="VersionText" Opacity="0.7" Style="{ThemeResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <RichTextBlock x:Name="ChangelogView" IsTextSelectionEnabled="True" />
            </Border>

            <HyperlinkButton x:Uid="Disclaimer_ReadAgain" Click="OnReadDisclaimer" Padding="0" Margin="4,0,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
